# ============================================================
# Bilim Nuru CRM+LMS — Production env template (VPS / docker compose)
# Copy to .env.production.local and fill in. NEVER commit the real file.
#
# This SINGLE file is loaded by every service in compose.yaml
# (db, api, front). Fill every required value or the api refuses
# to boot (see src/libs/env.validation.ts).
# ============================================================

# ----- Database (db container) -------------------------------------------
# The db container is initialised with these on first start.
POSTGRES_DB=crm_prod
POSTGRES_USER=leo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connection string the api uses. Host is the compose service name `db`.
# IMPORTANT: the password here MUST equal POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://leo:CHANGE_ME_STRONG_PASSWORD@db:5432/crm_prod

# Pooled connection limit for a long-running server (Prisma). 1 is the
# serverless default and will bottleneck a VPS — use 10.
DATABASE_CONNECTION_LIMIT=10

# ----- JWT (REQUIRED, min 32 chars each) ---------------------------------
# Generate: openssl rand -base64 64
# NOTE: JWT_ACCESS_SECRET is ALSO read by the front container — its
# middleware verifies the access-token signature with this exact value.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Encryption (REQUIRED in production, min 32 chars) -----------------
# Encrypts per-org provider tokens at rest. Generate: openssl rand -base64 32
# (Variable name is APP_ENCRYPTION_KEY — the code reads exactly this.)
APP_ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_AT_LEAST_32_CHARS

# ----- CORS (REQUIRED in production; "*" is rejected) --------------------
# Frontend origin(s), comma-separated. Must be the real domain over https.
ALLOWED_ORIGINS=https://bilimnuru.com

# ----- App ---------------------------------------------------------------
NODE_ENV=production
PORT=3001

# ----- Seed (first deploy of an EMPTY db only) ---------------------------
# Leave false when restoring a database dump (the migration path).
RUN_SEED=false
# Used only when RUN_SEED=true:
# SUPER_ADMIN_EMAIL=admin@bilimnuru.com
# SUPER_ADMIN_PASSWORD=CHANGE_ME

# ----- Billing cron (optional) -------------------------------------------
# Monthly invoice generation runs in-process via @nestjs/schedule.
# CRON_SECRET only protects the manual HTTP trigger /api/billing/cron/generate-month.
# CRON_SECRET=

# ----- Observability (optional) ------------------------------------------
# SENTRY_DSN=

# ----- Notifications (optional — worker disabled for MVP) ----------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
