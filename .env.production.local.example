# ============================================================
# Bilim Nuru CRM+LMS — Production Environment Template
# Copy this file to .env.production.local and fill in values
# NEVER commit .env.production.local to git
# ============================================================

# ----- Database ------------------------------------------
# Provided automatically by compose.yaml via DATABASE_URL override
# DATABASE_URL=postgresql://leo:CHANGE_ME@db:5432/crm_prod

# Postgres password (used by compose.yaml db service)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ----- JWT -----------------------------------------------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Encryption ----------------------------------------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_CHARS

# ----- CORS ----------------------------------------------
# Comma-separated list of allowed frontend origins
# Example: https://app.bilim-nuru.uz,https://admin.bilim-nuru.uz
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ----- App -----------------------------------------------
NODE_ENV=production
PORT=3001

# ----- Seed (first deploy only) --------------------------
# Set to true ONLY on very first deploy to create super admin
# Change back to false after first deploy!
RUN_SEED=false

# ----- Notifications (optional — disabled for MVP) -------
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_CLOUD_TOKEN=
