# Backend only. Never prefix any secret below with NEXT_PUBLIC_.
ACCOUNT_AUTH_ENABLED=false
AUTH_BFF_SECRET=
APP_ENCRYPTION_KEY=
AUTH_APP_URL=https://your-next-app.example
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-next-app.example/api/auth/google/callback
# Keep existing DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
# JWT_ACCESS_EXPIRES_IN, JWT_REFRESH_EXPIRES_IN and ALLOWED_ORIGINS settings.
