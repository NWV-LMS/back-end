# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bilim_nuru?schema=public"
# Prisma connection pool size. Default is 1 (safe for Vercel serverless).
# Set to 10-20 for traditional server deployments (Docker/VPS/k8s).
# Ignored if DATABASE_URL already contains connection_limit=.
# DATABASE_CONNECTION_LIMIT=10

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=7860
NODE_ENV=development   # development | production
# Log level for pino: trace | debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Minimum 32 characters each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_minimum_32_char_secret_access
JWT_REFRESH_SECRET=replace_with_minimum_32_char_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS (required in production) ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ─── Encryption (required in production) ─────────────────────────────────────
# 32+ char key for encrypting per-org notification tokens (Telegram, WhatsApp)
# Generate with: openssl rand -hex 32
# APP_ENCRYPTION_KEY=replace_with_minimum_32_char_encryption_key

# ─── Notifications (per-organization, stored encrypted in DB) ─────────────────
# These are optional global defaults — per-org tokens are managed via UI
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
